# Bake the lock-bound ACP entry onto the task image.
# Pins and runtime.node come from acp_entries.json (renderer fills the markers).
# No floating npx.
# Build context = this plugin package root.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root

# Node 22.x when `node -v` is missing or below the entry floor.
# A recipe Node that already meets the floor stays as written.
RUN __ACP_NODE_GATE__

# Pinned engine + ACP packages for options.entry.
RUN npm install -g __ACP_ENTRY_PACKAGES__ \
    && npm cache clean --force

# Required command realpath must be that package's bin. Aliases are not checked.
RUN __ACP_DETECT_BINARIES__
