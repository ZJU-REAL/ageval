# Copy to services/registry/.env (gitignored) and fill secrets.

AGEVAL_GITHUB_CLIENT_ID=
AGEVAL_GITHUB_CLIENT_SECRET=

AGEVAL_REGISTRY_DATABASE_URL=postgresql://ageval:ageval@127.0.0.1:5433/ageval_registry

AGEVAL_REGISTRY_S3_ENDPOINT=http://127.0.0.1:9000
AGEVAL_REGISTRY_S3_ACCESS_KEY=ageval
AGEVAL_REGISTRY_S3_SECRET_KEY=agevalageval
AGEVAL_REGISTRY_S3_BUCKET=ageval
AGEVAL_REGISTRY_S3_REGION=us-east-1

AGEVAL_REGISTRY_HOST=127.0.0.1
AGEVAL_REGISTRY_PORT=8700

# Public process model (ignored by --local unless --workers is set)
# AGEVAL_REGISTRY_WORKERS=4
# AGEVAL_REGISTRY_UPLOAD_SLOTS=4
# Proxy body limit must match the application cap (512 MiB).

# Comma-separated GitHub logins allowed to ageval login / Hub OAuth.
# Unset or empty = any GitHub user who completes OAuth (still needs CLIENT_ID/SECRET).
# Non-empty = those logins only. Closed Hub: set the list.
AGEVAL_GITHUB_LOGIN_ALLOWLIST=

# Hub browser OAuth callback allowlist (optional extras).
# Built-in: Vite :5174 and compose Hub :8080 (127.0.0.1 and localhost).
# AGEVAL_GITHUB_WEB_REDIRECT_URIS=https://hub.example.com/login/callback
#
# GitHub OAuth App → Authorization callback URL must include e.g.:
#   http://127.0.0.1:5174/login/callback
#   http://localhost:5174/login/callback
#   http://127.0.0.1:8080/login/callback

# Plugin marketplace official mark (Registry process only; not CLI lock/run).
# Comma-separated upload org slugs (lowercase, same as org-create).
# Unset → default org official. Replaces the default list when set.
# Those slugs are reserved: only admin can create them; nobody can claim them.
# AGEVAL_OFFICIAL_ORGS=official

# Platform maintainers (GitHub logins). Builtin plugin/agent owners.
# Independent of official orgs. Unset = nobody.
# AGEVAL_REGISTRY_MAINTAINERS=yourlogin

# Registry bootstrap token. Startup registers this bearer with admin scope.
# Operators set the same value as AGEVAL_REGISTRY_TOKEN in CLI to create reserved
# official orgs and add/remove members. Do not give this token to org owners.
# If unset, the process prints a one-shot token on stderr.
# AGEVAL_REGISTRY_BOOTSTRAP_TOKEN=

# Hosted jobs. 32 bytes, urlsafe base64. Registry and the hosted worker both
# need this key. Org secret values are encrypted with it. The worker does not
# read a tenant Docker socket. Provider keys are org secrets, not this file.
# AGEVAL_HOSTED_SECRET_KEY=
# Seconds before a crashed worker's running job returns to the queue. 0 keeps it.
# AGEVAL_HOSTED_STALE_SECONDS=0
