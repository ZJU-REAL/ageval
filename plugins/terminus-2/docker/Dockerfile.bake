# Optional tmux bake. The executor still installs tmux at setup when this
# layer is absent, and fails closed if that install cannot finish.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Optional. Parent forwards AGEVAL_PIP_INDEX as this ARG. This layer uses apt.
ARG PIP_INDEX_URL=

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends tmux \
    && rm -rf /var/lib/apt/lists/*

USER ageval
WORKDIR /attempt/workspace
